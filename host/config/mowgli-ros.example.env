# Stage 2 only: copy to /etc/mowgli-lora/mowgli-ros.env for a host-based ROS
# deployment with matching ROS, Mowgli, and universal_gnss_ros2 environments.
# Do not install or enable this adapter during transport-only robot HIL.
# Containerized ROS/GNSS needs an explicit ntrip|tcp|none selector at its GPS
# container boundary; this host service is not that selector.
ROS_SETUP=/opt/ros/jazzy/setup.bash
MOWGLI_SETUP=/opt/mowgli/install/setup.bash
RTCM_HOST=127.0.0.1
RTCM_PORT=2233
RTCM_TOPIC=/_gps_internal/universal/rtcm
